#!/usr/bin/env bash
# Drive the real `smolf` CLI in an isolated verification run and keep evidence.
#
# A run is one directory outside the checkout:
#   <run>/data/      SMOLF_DATA_DIR for this run (cache, outputs, hydro/ENDHD.csv)
#   <run>/checkout/  optional read-only git worktree of the code under test
#   <run>/evidence/  transcripts: <n>-<feature>.cmd/.out/.err/.rc (kept by cleanup)
#   <run>/env        shell file with SMOLF_DATA_DIR and SMOLF (the binary used)
#
# Usage:
#   smolf-verify new [--ref <commit>] [--shared-cache]   create a run, print its dir
#   smolf-verify doctor <run> [--net]                   read-only health check
#   smolf-verify run <run> <feature-id> [--block-host H]... [--log-level L] -- <smolf args>
#                                                       run smolf, record evidence;
#                                                       --block-host fails DNS for H in
#                                                       Python (STAC API, PC signing, SIH);
#                                                       --log-level shows smolf's log at L
#   smolf-verify hectares <run> <geotiff>               per-class hectares of a map (class 5 too when published)
#   smolf-verify cleanup <run>                          remove checkout and data, keep evidence
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd -P)
repo=$(git -C "$here" rev-parse --show-toplevel)
home_dir=${SMOLF_VERIFY_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}/smolf-verify}

die() { echo "smolf-verify: $*" >&2; exit 2; }

load_run() {
  [ -n "${1:-}" ] || die "run dir required"
  run=$(cd "$1" 2>/dev/null && pwd -P) || die "no such run: $1"
  [ -f "$run/env" ] || die "not a run dir (no env file): $run"
  # shellcheck disable=SC1091
  . "$run/env"
}

cmd_new() {
  local ref="" shared=0
  while [ $# -gt 0 ]; do
    case $1 in
      --ref) [ -n "${2:-}" ] || die "new: --ref needs a commit"; ref=$2; shift 2 ;;
      --shared-cache) shared=1; shift ;;
      *) die "new: unknown option $1" ;;
    esac
  done
  if [ -n "$ref" ]; then
    # Resolve the ref before creating anything, so a typo is a usage error
    # (exit 2) and leaves no half-made run dir.
    local sha
    sha=$(git -C "$repo" rev-parse --verify --quiet "$ref^{commit}") \
      || die "new: --ref is not a commit: $ref"
    ref=$sha
  fi
  local cache_src=""
  if [ "$shared" = 1 ]; then
    # Share this checkout's cache, else the main worktree's (a linked worktree
    # has none until something ingests). Resolve before creating anything so a
    # missing cache never leaves a dangling link or a half-made run.
    local main_root
    main_root=$(dirname "$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)")
    if [ -d "$repo/data/cache" ]; then
      cache_src="$repo/data/cache"
    elif [ -d "$main_root/data/cache" ]; then
      cache_src="$main_root/data/cache"
    elif [ "$main_root" = "$repo" ]; then
      die "new: --shared-cache found no cache dir at $repo/data/cache"
    else
      die "new: --shared-cache found no cache dir: tried $repo/data/cache and $main_root/data/cache"
    fi
  fi
  local run_id; run_id=$(date -u +%Y%m%dT%H%M%SZ)-$$
  local run="$home_dir/$run_id"
  mkdir -p "$run/data" "$run/evidence"
  local smolf="$repo/.venv/bin/smolf" code="$repo"
  if [ -n "$ref" ]; then
    git -C "$repo" worktree add -q --detach "$run/checkout" "$ref"
    (cd "$run/checkout" && uv sync -q --frozen)
    chmod -R a-w "$run/checkout"
    smolf="$run/checkout/.venv/bin/smolf"
    code="$run/checkout"
  fi
  [ -x "$smolf" ] || die "no smolf binary at $smolf (run \`uv sync\` in $repo)"
  if [ "$shared" = 1 ]; then
    # Reuse the checkout's scene cache so a series build does not re-download
    # ~470 scenes (about an hour cold). Never run two builds on it at once.
    ln -s "$cache_src" "$run/data/cache"
  fi
  {
    echo "SMOLF_DATA_DIR='$run/data'"
    echo "SMOLF='$smolf'"
    echo "SMOLF_CODE='$code'"
    echo "export SMOLF_DATA_DIR"
  } > "$run/env"
  echo "$run"
}

cmd_doctor() {
  load_run "${1:-}"; shift
  local net=0 bad=0
  case ${1:-} in
    "") ;;
    --net) net=1 ;;
    *) die "doctor: unknown option $1" ;;
  esac
  [ $# -le 1 ] || die "doctor: unexpected argument $2"
  echo "run:        $run"
  echo "code:       $SMOLF_CODE ($(git -C "$SMOLF_CODE" rev-parse --short HEAD))"
  echo "data dir:   $SMOLF_DATA_DIR"
  if out=$("$SMOLF" version 2>&1); then
    echo "smolf:      $out"
  else
    echo "smolf:      FAIL $out"; bad=1
  fi
  local dirty; dirty=$(git -C "$SMOLF_CODE" status --porcelain)
  if [ -n "$dirty" ]; then
    echo "git:        DIRTY (series runs record dirty: true and publish refuses)"
    echo "$dirty" | sed 's/^/            /'
  else
    echo "git:        clean"
  fi
  if [ -w "$SMOLF_CODE/src" ]; then echo "checkout:   writable"; else echo "checkout:   read-only"; fi
  local cache="$SMOLF_DATA_DIR/cache"
  if [ -d "$cache" ]; then
    echo "cache:      $(find -L "$cache" -maxdepth 1 -name '*.tif' | wc -l) scenes ($( [ -L "$cache" ] && echo shared || echo own ))"
  elif [ -L "$cache" ]; then
    echo "cache:      BROKEN link -> $(readlink "$cache")"; bad=1
  else
    echo "cache:      empty (first ingest downloads every scene)"
  fi
  if [ "$net" = 1 ]; then
    # Mirror smolf's SIH access: the site's bot protection redirect-loops (or
    # 403s) clients without cookies and smolf's User-Agent, so send both.
    local ua code rc url
    if ! ua=$("$(dirname "$SMOLF")/python" -c 'from smol_frontier.hydro.levels import USER_AGENT; print(USER_AGENT)' 2>/dev/null) || [ -z "$ua" ]; then
      echo "net:        SKIP (cannot read smolf USER_AGENT)"; bad=1
    else
      for url in https://earth-search.aws.element84.com/v1 \
                 https://planetarycomputer.microsoft.com/api/stac/v1 \
                 https://sih.conagua.gob.mx/basedatos/Presas/ENDHD.csv; do
        # Keep curl's HTTP code and its exit status apart: a failure after the
        # last response (time limit, redirect loop) must not corrupt the code.
        code=$(curl -s -o /dev/null -m 20 -L -b "" -A "$ua" -w '%{http_code}' "$url") && rc=0 || rc=$?
        [ -n "$code" ] || code=000
        if [ "$rc" = 0 ]; then
          echo "net:        $code $url"
        else
          echo "net:        $code (curl exit $rc) $url"
        fi
      done
    fi
  fi
  echo "evidence:   $(find "$run/evidence" -type f | wc -l) files in $run/evidence"
  return $bad
}

# Injected into smolf's Python only for one `run` (via PYTHONPATH); never part
# of smolf. It fails DNS for the listed hosts at socket.getaddrinfo, which is
# where a real outage surfaces (requests raises ConnectionError), and turns on
# smolf's own logging. GDAL/curl COG reads bypass Python sockets: blocking a
# STAC host does not block reads of scene files.
write_inject() {
  mkdir -p "$run/inject"
  cat > "$run/inject/sitecustomize.py" <<'PY'
"""smolf-verify fault and log injection (see smolf-verify `run`)."""

import os

_HOSTS = {h for h in os.environ.get("SMOLF_VERIFY_BLOCK_HOSTS", "").split(",") if h}
if _HOSTS:
    import socket

    _real_getaddrinfo = socket.getaddrinfo

    def _getaddrinfo(host, *args, **kwargs):
        name = host.decode() if isinstance(host, (bytes, bytearray)) else host
        if name in _HOSTS:
            raise socket.gaierror(socket.EAI_NONAME, f"{name} blocked by smolf-verify")
        return _real_getaddrinfo(host, *args, **kwargs)

    socket.getaddrinfo = _getaddrinfo

_LEVEL = os.environ.get("SMOLF_VERIFY_LOG_LEVEL")
if _LEVEL:
    import logging

    logging.basicConfig(
        level=_LEVEL.upper(), format="%(levelname)s %(name)s: %(message)s"
    )
PY
}

cmd_run() {
  load_run "${1:-}"; shift
  [ -n "${1:-}" ] || die "run: feature id required"
  local feature=$1; shift
  local hosts="" level=""
  while [ $# -gt 0 ] && [ "$1" != "--" ]; do
    case $1 in
      --block-host) [ -n "${2:-}" ] || die "run: --block-host needs a host"
                    hosts="${hosts:+$hosts,}$2"; shift 2 ;;
      --log-level) [ -n "${2:-}" ] || die "run: --log-level needs a level"
                   level=$2; shift 2 ;;
      *) die "run: unknown option $1 (smolf args go after --)" ;;
    esac
  done
  [ "${1:-}" = "--" ] && shift
  local n; n=$(printf '%02d' $(( $(find "$run/evidence" -name '*.cmd' | wc -l) + 1 )))
  local base="$run/evidence/$n-$feature"
  local -a env_args=("SMOLF_DATA_DIR=$SMOLF_DATA_DIR")
  if [ -n "$hosts$level" ]; then
    write_inject
    env_args+=("PYTHONPATH=$run/inject" "SMOLF_VERIFY_BLOCK_HOSTS=$hosts" "SMOLF_VERIFY_LOG_LEVEL=$level")
  fi
  { printf 'cd /tmp && env'; printf ' %q' "${env_args[@]}" "$SMOLF" "$@"; echo; } > "$base.cmd"
  local rc=0
  (cd /tmp && env "${env_args[@]}" "$SMOLF" "$@") > "$base.out" 2> "$base.err" || rc=$?
  echo "$rc" > "$base.rc"
  cat "$base.out"
  echo "[smolf-verify] exit=$rc evidence=$base.{cmd,out,err,rc}" >&2
  return 0
}

cmd_hectares() {
  load_run "${1:-}"; shift
  [ -n "${1:-}" ] || die "hectares: classified GeoTIFF required"
  local tif=$1
  [ $# -eq 1 ] || die "hectares: unexpected argument $2"
  local py; py=$(dirname "$SMOLF")/python
  (cd /tmp && "$py" - "$tif" <<'PY'
import sys

import rasterio

from smol_frontier.config import settings

with rasterio.open(sys.argv[1]) as src:
    data = src.read(1)
    pixel_ha = abs(src.transform.a * src.transform.e) / 10_000
    # A published map (publish, export maps) also has class 5 in its legend.
    published = "class_5" in src.tags(1)
names = ["CLASS_WATER", "CLASS_DENSE_HYACINTH", "CLASS_INTERFACE", "CLASS_BARE_SOIL"]
if published:
    names.append("CLASS_BED_REMOVED")
for name in names:
    code = getattr(settings, name)
    print(f"{name.removeprefix('CLASS_').lower()}_ha: {(data == code).sum() * pixel_ha:.2f}")
PY
  )
}

cmd_cleanup() {
  load_run "${1:-}"
  [ $# -le 1 ] || die "cleanup: unexpected argument $2"
  if [ -d "$run/checkout" ]; then
    chmod -R u+w "$run/checkout"
    # A checkout whose worktree record is already gone is not a working tree
    # to git; delete the directory itself so the run still cleans up.
    git -C "$repo" worktree remove --force "$run/checkout" 2>/dev/null ||
      rm -rf "$run/checkout"
    git -C "$repo" worktree prune
  fi
  # rm -rf does not follow the shared-cache symlink; only the link goes.
  rm -rf "$run/data"
  echo "kept evidence: $run/evidence ($(find "$run/evidence" -type f | wc -l) files)"
}

case ${1:-} in
  new) shift; cmd_new "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  run) shift; cmd_run "$@" ;;
  hectares) shift; cmd_hectares "$@" ;;
  cleanup) shift; cmd_cleanup "$@" ;;
  *) sed -n '2,20p' "$0"; exit 2 ;;
esac
