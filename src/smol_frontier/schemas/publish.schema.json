{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oscolv/smol-frontier/schemas/publish.schema.json",
  "title": "smolf publish.json",
  "description": "Integrity index of one publish: the relative path and sha256 of every other published file, plus when and from which run it was generated. It is the only non-deterministic file of the contract and never lists itself. Additional properties are allowed.",
  "type": "object",
  "required": [
    "schema_version",
    "smolf_version",
    "run_id",
    "series_sha256",
    "generated_utc",
    "files"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^3\\.[0-9]+\\.[0-9]+$",
      "not": {
        "pattern": "\\n"
      }
    },
    "smolf_version": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "series_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generated_utc": {
      "description": "ISO-8601 UTC timestamp with a trailing Z.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "files": {
      "description": "Every other file of the published directory, sorted by path.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "description": "POSIX path relative to the output directory; only allowlisted names.",
            "type": "string",
            "pattern": "^(?:latest\\.json|series\\.json|map/[0-9]{4}-[0-9]{2}-[0-9]{2}_[A-Za-z0-9_.-]+\\.(?:tif|png))$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
