{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oscolv/smol-frontier/schemas/series.schema.json",
  "title": "smolf series.json",
  "description": "Every ok and every POOR (skipped) scene of a series run, sorted by date; error scenes are excluded. A POOR entry carries date, item_id, quality_light, valid_frac, display_status HIDDEN and null for every other field (display_ha included). Entries share the per-scene fields of latest.json (the field definitions are duplicated here, not referenced). monthly is the per-month median of hyacinth_corrected_ha over non-HIDDEN scenes. stage_area_curve is the committed stage–area curve A(h) the exposed-bed correction reads, in hectares. exposed_bed_example is the dry-season control scene with its raw and corrected maps, or null. Additional properties are allowed.",
  "type": "object",
  "required": [
    "schema_version",
    "smolf_version",
    "run_id",
    "series_sha256",
    "scenes",
    "monthly",
    "stage_area_curve",
    "exposed_bed_example"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^3\\.[0-9]+\\.[0-9]+$",
      "not": {
        "pattern": "\\n"
      }
    },
    "smolf_version": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "series_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scenes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "monthly": {
      "description": "One entry per calendar month, contiguous and in order, from the first to the last scene month (HIDDEN scenes count toward the span).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/month"
      }
    },
    "stage_area_curve": {
      "description": "The committed stage–area curve (data/hydro/stage_area_curve.csv), never refitted: parallel arrays with one entry per grid row, areas converted from km² to hectares. Since 3.4.0.",
      "type": "object",
      "required": [
        "stage_m",
        "area_ha",
        "area_ha_p2_5",
        "area_ha_p97_5",
        "stage_min_m",
        "stage_max_m",
        "anchors",
        "sha256"
      ],
      "properties": {
        "stage_m": {
          "description": "Grid stages, m a.s.l., ascending, 3 decimals.",
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "number"
          }
        },
        "area_ha": {
          "description": "Fitted water-surface area at each stage, ha.",
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/area"
          }
        },
        "area_ha_p2_5": {
          "description": "Bootstrap 2.5th percentile of the area at each stage, ha.",
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/area"
          }
        },
        "area_ha_p97_5": {
          "description": "Bootstrap 97.5th percentile of the area at each stage, ha.",
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/area"
          }
        },
        "stage_min_m": {
          "description": "First grid stage, m a.s.l.",
          "type": "number"
        },
        "stage_max_m": {
          "description": "Last grid stage, m a.s.l.; the curve is undefined above it.",
          "type": "number"
        },
        "anchors": {
          "description": "Official level–volume points the V(h) fit is pinned to.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/curve_anchor"
          }
        },
        "sha256": {
          "description": "sha256 of the committed curve CSV; equals the run manifest's stage_area_curve_csv input.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "exposed_bed_example": {
      "description": "The scene of EXPOSED_BED_EXAMPLE_DATE (2024-06-09, the dry-season control): the run's first ok record of that date, as its scenes entry plus margin_m, expected_bed_ha, map_raw and map_corrected. Null when the run has no such record or its correction did not apply; never another scene. Since 3.4.0.",
      "anyOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/scene"
            },
            {
              "type": "object",
              "required": [
                "bed_applied",
                "level_m",
                "removed_ha",
                "margin_m",
                "expected_bed_ha",
                "map_raw",
                "map_corrected"
              ],
              "properties": {
                "bed_applied": {
                  "const": true
                },
                "level_m": {
                  "description": "The day's SIH level the correction used, m a.s.l.; never null here.",
                  "type": "number"
                },
                "removed_ha": {
                  "$ref": "#/$defs/area"
                },
                "margin_m": {
                  "description": "Margin stage (level_m plus the uncertainty cushion): hyacinth on bed whose flood stage lies above it was removed; m a.s.l., 2 decimals, copied from the run row.",
                  "type": "number"
                },
                "expected_bed_ha": {
                  "description": "Expected exposed bed: staged area of the flood-stage map above level_m, ha, 2 decimals, copied from the run row.",
                  "$ref": "#/$defs/area"
                },
                "map_raw": {
                  "description": "RGBA PNG of the classifier's classes 0-4, before the exposed-bed correction, on the map.png grid.",
                  "type": "object",
                  "required": [
                    "path",
                    "bounds"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^map/[0-9]{4}-[0-9]{2}-[0-9]{2}_[A-Za-z0-9_.-]+\\.raw\\.png$"
                    },
                    "bounds": {
                      "$ref": "#/$defs/bounds"
                    }
                  }
                },
                "map_corrected": {
                  "description": "RGBA PNG of classes 0-5 (class 5 = removed by the exposed-bed correction), on the map.png grid; the latest map.png when the example is the latest scene.",
                  "type": "object",
                  "required": [
                    "path",
                    "bounds"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^map/[0-9]{4}-[0-9]{2}-[0-9]{2}_[A-Za-z0-9_.-]+\\.png$",
                      "not": {
                        "pattern": "\\.raw\\.png$"
                      }
                    },
                    "bounds": {
                      "$ref": "#/$defs/bounds"
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "area": {
      "type": "number",
      "minimum": 0
    },
    "area_or_null": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "scene": {
      "type": "object",
      "required": [
        "date",
        "item_id",
        "quality_light",
        "regime",
        "valid_frac",
        "cloud_frac",
        "dense_ha",
        "interface_ha",
        "hyacinth_raw_ha",
        "hyacinth_under_haze_ha",
        "pct_reservoir_raw",
        "bed_applied",
        "bed_reason",
        "level_m",
        "removed_ha",
        "dense_corrected_ha",
        "interface_corrected_ha",
        "hyacinth_corrected_ha",
        "pct_reservoir_corrected",
        "cover_band",
        "display_status",
        "display_ha"
      ],
      "properties": {
        "date": {
          "$ref": "#/$defs/date"
        },
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "quality_light": {
          "enum": [
            "GOOD",
            "DOUBTFUL",
            "POOR"
          ]
        },
        "regime": {
          "enum": [
            "CLEAN",
            "EXPOSED_BED",
            "TURBIDITY",
            null
          ]
        },
        "valid_frac": {
          "$ref": "#/$defs/fraction"
        },
        "cloud_frac": {
          "anyOf": [
            {
              "$ref": "#/$defs/fraction"
            },
            {
              "type": "null"
            }
          ]
        },
        "dense_ha": {
          "anyOf": [
            {
              "$ref": "#/$defs/area"
            },
            {
              "type": "null"
            }
          ]
        },
        "interface_ha": {
          "anyOf": [
            {
              "$ref": "#/$defs/area"
            },
            {
              "type": "null"
            }
          ]
        },
        "hyacinth_raw_ha": {
          "anyOf": [
            {
              "$ref": "#/$defs/area"
            },
            {
              "type": "null"
            }
          ]
        },
        "hyacinth_under_haze_ha": {
          "anyOf": [
            {
              "$ref": "#/$defs/area"
            },
            {
              "type": "null"
            }
          ]
        },
        "pct_reservoir_raw": {
          "anyOf": [
            {
              "$ref": "#/$defs/percent"
            },
            {
              "type": "null"
            }
          ]
        },
        "bed_applied": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "bed_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "level_m": {
          "type": [
            "number",
            "null"
          ]
        },
        "removed_ha": {
          "$ref": "#/$defs/area_or_null"
        },
        "dense_corrected_ha": {
          "$ref": "#/$defs/area_or_null"
        },
        "interface_corrected_ha": {
          "$ref": "#/$defs/area_or_null"
        },
        "hyacinth_corrected_ha": {
          "$ref": "#/$defs/area_or_null"
        },
        "pct_reservoir_corrected": {
          "anyOf": [
            {
              "$ref": "#/$defs/percent"
            },
            {
              "type": "null"
            }
          ]
        },
        "cover_band": {
          "enum": [
            "GREEN",
            "YELLOW",
            "RED",
            null
          ]
        },
        "display_status": {
          "enum": [
            "FULL",
            "LOWER_BOUND",
            "HIDDEN"
          ]
        },
        "display_ha": {
          "anyOf": [
            {
              "$ref": "#/$defs/display_ha"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "if": {
        "properties": {
          "quality_light": {
            "const": "POOR"
          }
        }
      },
      "then": {
        "properties": {
          "regime": {
            "type": "null"
          },
          "cloud_frac": {
            "type": "null"
          },
          "dense_ha": {
            "type": "null"
          },
          "interface_ha": {
            "type": "null"
          },
          "hyacinth_raw_ha": {
            "type": "null"
          },
          "hyacinth_under_haze_ha": {
            "type": "null"
          },
          "pct_reservoir_raw": {
            "type": "null"
          },
          "bed_applied": {
            "type": "null"
          },
          "bed_reason": {
            "type": "null"
          },
          "level_m": {
            "type": "null"
          },
          "removed_ha": {
            "type": "null"
          },
          "dense_corrected_ha": {
            "type": "null"
          },
          "interface_corrected_ha": {
            "type": "null"
          },
          "hyacinth_corrected_ha": {
            "type": "null"
          },
          "pct_reservoir_corrected": {
            "type": "null"
          },
          "cover_band": {
            "type": "null"
          },
          "display_status": {
            "const": "HIDDEN"
          },
          "display_ha": {
            "type": "null"
          }
        }
      },
      "else": {
        "description": "A scene with figures: the same definitions as the per-scene fields of latest.json (kept identical by a test).",
        "properties": {
          "date": {
            "description": "UTC acquisition date.",
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "quality_light": {
            "description": "Never POOR here: a POOR scene has no figures.",
            "enum": [
              "GOOD",
              "DOUBTFUL"
            ]
          },
          "regime": {
            "enum": [
              "CLEAN",
              "EXPOSED_BED",
              "TURBIDITY"
            ]
          },
          "valid_frac": {
            "$ref": "#/$defs/fraction"
          },
          "cloud_frac": {
            "$ref": "#/$defs/fraction"
          },
          "dense_ha": {
            "$ref": "#/$defs/area"
          },
          "interface_ha": {
            "$ref": "#/$defs/area"
          },
          "hyacinth_raw_ha": {
            "$ref": "#/$defs/area"
          },
          "hyacinth_under_haze_ha": {
            "description": "Raw hyacinth (dense + interface) rescued under thin haze; included in hyacinth_raw_ha. Since 3.3.0.",
            "$ref": "#/$defs/area"
          },
          "pct_reservoir_raw": {
            "$ref": "#/$defs/percent"
          },
          "bed_applied": {
            "type": "boolean"
          },
          "bed_reason": {
            "type": "string"
          },
          "level_m": {
            "type": [
              "number",
              "null"
            ]
          },
          "removed_ha": {
            "$ref": "#/$defs/area_or_null"
          },
          "dense_corrected_ha": {
            "$ref": "#/$defs/area_or_null"
          },
          "interface_corrected_ha": {
            "$ref": "#/$defs/area_or_null"
          },
          "hyacinth_corrected_ha": {
            "$ref": "#/$defs/area_or_null"
          },
          "pct_reservoir_corrected": {
            "anyOf": [
              {
                "$ref": "#/$defs/percent"
              },
              {
                "type": "null"
              }
            ]
          },
          "cover_band": {
            "enum": [
              "GREEN",
              "YELLOW",
              "RED",
              null
            ]
          },
          "display_status": {
            "description": "Display gate of the scene, the deterministic part of a consumer's quality gate: HIDDEN when quality_light is not GOOD or hyacinth_corrected_ha is null; LOWER_BOUND when valid_frac is below constants.frac_publishable (figures read 'at least'); FULL otherwise. A consumer's editorial holds and withdrawals are not reflected.",
            "enum": [
              "FULL",
              "LOWER_BOUND",
              "HIDDEN"
            ]
          },
          "display_ha": {
            "description": "Integer display hectares whose parts sum to the total: total is hyacinth_corrected_ha rounded half up; dense and interface start as floors of their corrected figures and the missing units go by largest fractional remainder, ties to dense. Null whenever the corrected figures are null.",
            "anyOf": [
              {
                "$ref": "#/$defs/display_ha"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "bed_applied": {
                  "const": false
                }
              }
            },
            "then": {
              "properties": {
                "removed_ha": {
                  "type": "null"
                },
                "dense_corrected_ha": {
                  "type": "null"
                },
                "interface_corrected_ha": {
                  "type": "null"
                },
                "hyacinth_corrected_ha": {
                  "type": "null"
                },
                "pct_reservoir_corrected": {
                  "type": "null"
                },
                "cover_band": {
                  "type": "null"
                },
                "display_ha": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "removed_ha": {
                  "type": "number"
                },
                "dense_corrected_ha": {
                  "type": "number"
                },
                "interface_corrected_ha": {
                  "type": "number"
                },
                "hyacinth_corrected_ha": {
                  "type": "number"
                },
                "pct_reservoir_corrected": {
                  "type": "number"
                },
                "cover_band": {
                  "type": "string"
                },
                "display_ha": {
                  "type": "object"
                }
              }
            }
          }
        ]
      }
    },
    "display_ha": {
      "type": "object",
      "required": [
        "total",
        "dense",
        "interface"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "dense": {
          "type": "integer",
          "minimum": 0
        },
        "interface": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "month": {
      "type": "object",
      "required": [
        "month",
        "median_ha",
        "n_scenes"
      ],
      "properties": {
        "month": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
        },
        "median_ha": {
          "description": "Ordinary median (mean of the two middle values when the count is even) of the month's non-HIDDEN hyacinth_corrected_ha, rounded half up to 2 decimals; null when n_scenes is 0.",
          "anyOf": [
            {
              "$ref": "#/$defs/area"
            },
            {
              "type": "null"
            }
          ]
        },
        "n_scenes": {
          "description": "The month's scenes with display_status FULL or LOWER_BOUND.",
          "type": "integer",
          "minimum": 0
        }
      },
      "if": {
        "properties": {
          "n_scenes": {
            "const": 0
          }
        }
      },
      "then": {
        "properties": {
          "median_ha": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "median_ha": {
            "type": "number"
          }
        }
      }
    },
    "curve_anchor": {
      "type": "object",
      "required": [
        "stage_m",
        "volume_hm3",
        "source"
      ],
      "properties": {
        "stage_m": {
          "type": "number"
        },
        "volume_hm3": {
          "type": "number",
          "minimum": 0
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "bounds": {
      "description": "EPSG:4326 extent of a PNG as [[south, west], [north, east]], 6 decimals.",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "prefixItems": [
          {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        ]
      }
    }
  }
}
